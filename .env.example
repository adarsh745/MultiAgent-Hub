# WorkPilot AI - Environment Variable Configuration Template
# Copy this file to .env and replace placeholders with actual values.

# General Configuration
APP_NAME=WorkPilot AI
APP_ENV=development
PORT=8000
LOG_LEVEL=info

# Backend & Security
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=workpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/workpilot_db

# Vector Database Configuration (e.g., Qdrant / Pgvector)
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=your_vector_db_api_key_here

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# AI / LLM Provider Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Model Context Protocol (MCP) Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001

# Jira Cloud Configuration (placeholders only)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# GitHub Configuration (placeholders only)
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your_github_owner
GITHUB_REPO=your_github_repo

# Slack Configuration (placeholders only)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=general

